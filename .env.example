# 이름만 적어 둔 예시입니다. 실제 값은 .env.local(저장소에 올리지 않음)과 Vercel 환경변수에 넣어요.

# 브라우저 공개 가능 (RLS가 켜져 있어야 안전)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용. NEXT_PUBLIC_ 을 붙이지 않아요. 운영 환경에만 등록해요.
SUPABASE_SERVICE_ROLE_KEY=

# AI 공급자 키 (서버 전용, 유료 등급). 미리보기 환경에는 넣지 않아요 → 연습 모드로 동작
GEMINI_API_KEY=
OPENAI_API_KEY=

# 처음 운영자로 지정할 이메일 (쉼표로 구분)
ADMIN_EMAILS=
